# Fleetora Customer Web Environment Configuration
VITE_API_URL=http://localhost:4000

# OpenStreetMap / MapLibre GL Tile Provider
# Uses CARTO Positron vector tiles derived from OpenStreetMap (No Google API key required)
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Optional commercial tile provider key (MapTiler, Stadia) - Leave empty for open-source default
VITE_MAP_API_KEY=

# Open-Source Routing Provider (OSRM)
VITE_ROUTING_API_URL=https://router.project-osrm.org/route/v1/driving

# Open-Source Geocoding Provider (Nominatim)
VITE_GEOCODING_API_URL=https://nominatim.openstreetmap.org
